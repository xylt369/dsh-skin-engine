{
  "name": "@yeesy369/open-theme",
  "version": "1.1.4",
  "description": "Open Theme：给 DeepSeek Harness（dsh）Web UI 换皮肤的客户端插件——上传背景图自动取色换肤，支持自定义特效预设（skin / theme / background plugin for DeepSeek Harness web UI）",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "bin": {
    "open-theme": "./open-theme.mjs"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xylt369/open-theme.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "skin",
    "theme",
    "background",
    "open-theme"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "open-theme.mjs",
    "presets",
    "demo",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    },
    "compat": {
      "dsh": ">=0.1.0-rc.6 <0.2.0",
      "tested": [
        "0.1.0-rc.6"
      ],
      "note": "依赖 theme.overrideTokens / shell.overlay / sidebar.footer.action，运行时做能力检测，缺失时自动降级（背景图与动态效果仍可用），见 README「兼容性」。"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/dsh": ">=0.1.0-rc.6 <0.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  }
}
